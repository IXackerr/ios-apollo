+/*
+ * The panel scans the frame out of memory continuously (video mode): a
+ * copy into it while it is fetched shows half of one frame over half of
+ * another. So the vsync tick follows the panel's own: it fires as the
+ * visible lines end, and the copy starts in the blanking that follows.
+ * It writes rows several times faster than the panel fetches them, so it
+ * stays ahead of the fetch all the way down.
+ */
+void
+AppleCLCD::scanoutSetup(IOService *provider)
+{
+	OSData *reg = OSDynamicCast(OSData, provider->getProperty("intf-reg"));
+	if (reg == NULL || reg->getLength() < 16) {
+		return;
+	}
+	const uint64_t *r = (const uint64_t *)reg->getBytesNoCopy();
+	uint64_t page = r[0] & ~(uint64_t)PAGE_MASK;
+	vm_offset_t map = ml_io_map((vm_offset_t)page, (vm_size_t)round_page(r[0] + r[1] - page));
+	if (map == 0) {
+		return;
+	}
+	volatile uint32_t *intf = (volatile uint32_t *)(map + (r[0] - page));
+	uint32_t hperiod = intf[INTF_HSYNC_CTL / 4] >> 16;
+	uint32_t enabled = intf[INTF_TIMING_ENGINE_EN / 4] & 1;
+	if (intf[INTF_FRAME_LINE_COUNT_EN / 4] != 3) {
+		intf[INTF_FRAME_LINE_COUNT_EN / 4] = 3;
+	}
+	uint32_t lines = hperiod ? intf[INTF_VSYNC_PERIOD_F0 / 4] / hperiod : 0;
+	uint32_t vstart = hperiod ? intf[INTF_DISPLAY_V_START_F0 / 4] / hperiod : 0;
+	uint32_t vend = hperiod ? intf[INTF_DISPLAY_V_END_F0 / 4] / hperiod : 0;
+	uint32_t f0 = intf[INTF_FRAME_COUNT / 4];
+	uint64_t t0 = mach_absolute_time();
+	IOSleep(500);
+	uint32_t f1 = intf[INTF_FRAME_COUNT / 4];
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	uint32_t l0 = intf[INTF_LINE_COUNT / 4];
+	IODelay(200);
+	uint32_t l1 = intf[INTF_LINE_COUNT / 4];
+	uint32_t frames = f1 - f0;
+	IOLog("SWEET FB: scanout: engine %u, %u lines (visible %u-%u), %u frames in %llu ms, "
+	    "line %u then %u\n", enabled, lines, vstart, vend, frames, ns / 1000000, l0, l1);
+	if (!enabled || frames < 10 || vend <= vstart || lines <= vend || l0 == l1 ||
+	    l0 >= lines || l1 >= lines) {
+		IOLog("SWEET FB: scanout not followed: plain 60 Hz ticks\n");
+		return;
+	}
+	fLines = lines;
+	fActiveStart = vstart;
+	fActiveEnd = vend;
+	fLineNS = (uint32_t)(ns / frames / lines);
+	fIntf = intf;
+	IOLog("SWEET FB: following the scanout, %llu Hz\n", (uint64_t)frames * 1000000000ull / ns);
+}
+
+/* Spin (2 ms at most) until the panel fetches no visible line. */
+void
+AppleCLCD::scanoutWaitBlanking()
+{
+	if (fIntf == NULL) {
+		return;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(2, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		uint32_t line = fIntf[INTF_LINE_COUNT / 4];
+		if (line > fActiveEnd || line < fActiveStart || mach_absolute_time() > deadline) {
+			return;
+		}
+	}
+}
+
+/* Microseconds to the next tick: the end of the visible lines, a little early. */
+uint32_t
+AppleCLCD::nextTickUS()
+{
+	if (fIntf == NULL) {
+		return SWEET_FB_VSYNC_US;
+	}
+	uint32_t line = fIntf[INTF_LINE_COUNT / 4];
+	uint32_t to = (fActiveEnd + 1 + fLines - line % fLines) % fLines;
+	if (to == 0) {
+		to = fLines;    /* at the tick's own line: the next frame's */
+	}
+	uint64_t us = (uint64_t)to * fLineNS / 1000;
+	return us > 300 ? (uint32_t)(us - 300) : 1;
+}
