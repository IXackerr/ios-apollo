 int
 kmwrite(dev_t dev, struct uio * uio, int ioflag)
 {
 	int ret;
 	struct tty *tp = km_tty[minor(dev)];
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SWEET: what the processes in boot-arg sweetnull write to
+	 * /dev/console is printed directly, like their /dev/null writes
+	 * (bsd/dev/mem.c): through the tty it never showed up in the log.
+	 */
+	char name[32];
+	if (sweet_null_tee(name, sizeof(name))) {
+		while (uio_resid(uio) > 0) {
+			char buf[256];
+			int c = (int)MIN(uio_resid(uio), (user_ssize_t)sizeof(buf));
+			int error = uiomove(buf, c, uio);
+			if (error) {
+				return error;
+			}
+			printf("|%s| %.*s%s", name, c, buf, buf[c - 1] == '\n' ? "" : "\n");
+		}
+		return 0;
+	}
+#endif
+
 	tty_lock(tp);
 	ret = (*linesw[tp->t_line].l_write)(tp, uio, ioflag);
 	tty_unlock(tp);
