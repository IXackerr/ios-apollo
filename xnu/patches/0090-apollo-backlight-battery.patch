+++ b/iokit/Kernel/arm/SweetBacklight.cpp
@@ -0,0 +1,149 @@
+/*
+ * AppleARMBacklight for the apollo LCD backlight (WLED5, bsd/dev/sweet_wled.c).
+ *
+ * CoreBrightness, BrightnessControl and QuartzCore find the backlight by
+ * IOPropertyMatch {backlight-control = true}; CoreBrightness then requires
+ * the class to conform to AppleARMBacklight and reads IODisplayParameters
+ * (brightness {min, max, value} and BrightnessMilliNits {min, max, value}).
+ * Brightness arrives through setProperties as "brightness-nits" (16.16
+ * nits) or, on the legacy path, as a raw "brightness" in min..max. Every
+ * other key is accepted and ignored. Display power is not sent here: the
+ * framebuffer switches the WLED and this service only relays the
+ * will-power-off / has-powered-on messages CoreBrightness listens for.
+ * Boot-arg sweetbacklight=0 leaves it out.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMessage.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <pexpert/pexpert.h>
+
+extern "C" bool sweet_wled_present(void);
+extern "C" void sweet_wled_brightness(unsigned level);
+extern "C" unsigned sweet_wled_get_brightness(void);
+extern "C" void sweet_backlight_power(bool on);
+
+#define LEVEL_MAX       4095u
+#define MILLINITS_MIN   2000u
+#define MILLINITS_MAX   500000u        /* ~500 nits panel */
+
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	void powerChanged(bool on);
+
+private:
+	unsigned fLevel;
+	void publishParameters(void);
+	void apply(unsigned level);
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static AppleARMBacklight *gSweetBacklight;
+
+static OSDictionary *
+range(unsigned min, unsigned max, unsigned value)
+{
+	OSDictionary *d = OSDictionary::withCapacity(3);
+	const char *keys[] = {"min", "max", "value"};
+	unsigned values[] = {min, max, value};
+	for (unsigned i = 0; d && i < 3; i++) {
+		OSNumber *n = OSNumber::withNumber(values[i], 32);
+		if (n) {
+			d->setObject(keys[i], n);
+			n->release();
+		}
+	}
+	return d;
+}
+
+void
+AppleARMBacklight::publishParameters(void)
+{
+	OSDictionary *params = OSDictionary::withCapacity(2);
+	OSDictionary *raw = range(0, LEVEL_MAX, fLevel);
+	OSDictionary *nits = range(MILLINITS_MIN, MILLINITS_MAX,
+	    (unsigned)((uint64_t)fLevel * MILLINITS_MAX / LEVEL_MAX));
+	if (params && raw && nits) {
+		params->setObject("brightness", raw);
+		params->setObject("BrightnessMilliNits", nits);
+		setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(raw);
+	OSSafeReleaseNULL(nits);
+	OSSafeReleaseNULL(params);
+}
+
+void
+AppleARMBacklight::apply(unsigned level)
+{
+	if (level > LEVEL_MAX) {
+		level = LEVEL_MAX;
+	}
+	if (level != fLevel) {
+		fLevel = level;
+		sweet_wled_brightness(level);
+		publishParameters();
+	}
+}
+
+bool
+AppleARMBacklight::start(IOService *provider)
+{
+	int enabled = 1;
+
+	(void)PE_parse_boot_argn("sweetbacklight", &enabled, sizeof(enabled));
+	if (!enabled || !sweet_wled_present() || !IOService::start(provider)) {
+		return false;
+	}
+	fLevel = sweet_wled_get_brightness();
+	setProperty("backlight-control", true);
+	publishParameters();
+	gSweetBacklight = this;
+	registerService();
+	IOLog("SWEET BACKLIGHT: AppleARMBacklight registered, level %u of %u\n", fLevel, LEVEL_MAX);
+	return true;
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (!dict) {
+		return kIOReturnSuccess;
+	}
+	OSNumber *nits = OSDynamicCast(OSNumber, dict->getObject("brightness-nits"));
+	OSNumber *raw = OSDynamicCast(OSNumber, dict->getObject("brightness"));
+	if (nits) {
+		/* 16.16 nits -> level; the scale is linear in nits up to the panel max. */
+		uint64_t milli = (nits->unsigned64BitValue() * 1000u) >> 16;
+		apply((unsigned)(milli * LEVEL_MAX / MILLINITS_MAX));
+	} else if (raw) {
+		apply(raw->unsigned32BitValue());
+	}
+	return kIOReturnSuccess;
+}
+
+void
+AppleARMBacklight::powerChanged(bool on)
+{
+	messageClients(on ? kIOMessageDeviceHasPoweredOn : kIOMessageDeviceWillPowerOff);
+}
+
+/* Called by the framebuffer when the display goes off (after its fade) or on. */
+extern "C" void
+sweet_backlight_power(bool on)
+{
+	if (gSweetBacklight) {
+		gSweetBacklight->powerChanged(on);
+	}
+}
