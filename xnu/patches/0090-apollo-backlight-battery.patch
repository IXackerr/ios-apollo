+{
+	if (!sp_ready || addr > 0xffffu || !sp_writable(sid, addr)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
