+/* apollo: PM8150B, SID 2. Temperature stays the fixed 25 C: the gauge keeps
+ * it in its SRAM, which can only be read through writes to MEM_IF. */
+void
+SweetBattery::pollFuelGauge(void)
+{
+	uint8_t soc = 0, socCopy = 1, usb, path, charger, error, temperature, batif;
+	uint16_t rawVoltage, rawCurrent;
+	bool valid = false;
+	for (unsigned attempt = 0; attempt < 5 && !valid; ++attempt) {
+		valid = !sweet_spmi_read(2, 0x4009, &soc) && !sweet_spmi_read(2, 0x400a, &socCopy) &&
+		    soc == socCopy;
+	}
+	valid = valid &&
+	    readPair(0x41a0, 0x41a6, &rawVoltage) &&
+	    readPair(0x41a2, 0x41a8, &rawCurrent) &&
+	    !sweet_spmi_read(2, 0x1210, &batif) && !(batif & 0x30u) &&
+	    !sweet_spmi_read(2, 0x1310, &usb) &&
+	    !sweet_spmi_read(2, 0x110b, &path) &&
+	    !sweet_spmi_read(2, 0x1006, &charger) &&
+	    !sweet_spmi_read(2, 0x1007, &error) &&
+	    !sweet_spmi_read(2, 0x100d, &temperature);
+	unsigned mv = valid ? (unsigned)(((uint64_t)rawVoltage * 122070u) / 1000000u) : 0;
+	valid = valid && mv >= 2800 && mv <= 4600;
+	if (!valid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	/* CAF msoc scaling: 0 -> 0 %, 255 -> 100 %, linear in between. */
+	unsigned percent = soc == 0 ? 0 : soc == 255 ? 100 : ((soc - 1u) * 98u + 126u) / 253u + 1u;
+	/* Gauge: positive = discharging, 488.281 uA/LSB; IOPMPowerSource: positive = charging. */
+	int ma = (int)(-((int64_t)(int16_t)rawCurrent * 488281) / 1000000);
+	bool external = (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	/* Without the BQ charge pump a USB port may not cover the load: report
+	 * charging only while current really flows into the battery. */
+	bool charging = capable && state >= 1 && state <= 4 && ma > 0 &&
+	    !(error & 2u) && !(temperature & 0x0cu);
+	bool full = external && (state == 5 || (percent == 100 && !charging));
+	publish(full ? 100 : percent, mv, ma, external, capable, charging, full, true, true);
+}
