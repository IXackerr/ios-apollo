@@ -0,0 +1,94 @@
+/*
+ * apollo LCD backlight: WLED5 in PM8150L (SPMI SID 5, ctrl 0xd800, sink
+ * 0xd900). The bootloader has already set the strings, currents, OVP and
+ * switching frequency for its splash screen; this file only switches the
+ * module and sets the 12-bit MOD_A brightness. On sweet (AMOLED) there is
+ * no WLED at SID 5 and every call is a no-op.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include "sweet_spmi.h"
+
+#define WLED_SID		5
+#define WLED_TYPE		0xd804u
+#define WLED_SUBTYPE		0xd805u
+#define WLED_MOD_ENABLE		0xd846u
+#define WLED_MOD_EN		0x80u
+#define WLED_MOD_A_BRT_LSB	0xd953u
+#define WLED_MOD_A_BRT_MSB	0xd954u
+#define WLED_MOD_SYNC		0xd965u
+#define WLED_MOD_SYNC_A		0x01u
+#define WLED_MAX		4095u
+
+bool sweet_wled_present(void);
+void sweet_wled_power(bool on);
+void sweet_wled_brightness(unsigned level);
+unsigned sweet_wled_get_brightness(void);
+
+static int wled_state = -1;	/* -1 unknown, 0 absent, 1 present */
+
+bool
+sweet_wled_present(void)
+{
+	uint8_t type, subtype;
+
+	if (wled_state < 0) {
+		wled_state = sweet_spmi_init() == 0 &&
+		    !sweet_spmi_read(WLED_SID, WLED_TYPE, &type) && type == 0x17 &&
+		    !sweet_spmi_read(WLED_SID, WLED_SUBTYPE, &subtype) && subtype == 0x12;
+		if (wled_state) {
+			printf("SWEET WLED: PM8150L WLED5, brightness %u of %u\n",
+			    sweet_wled_get_brightness(), WLED_MAX);
+		}
+	}
+	return wled_state == 1;
+}
+
+void
+sweet_wled_power(bool on)
+{
+	uint8_t v;
+
+	if (!sweet_wled_present() || sweet_spmi_read(WLED_SID, WLED_MOD_ENABLE, &v)) {
+		return;
+	}
+	uint8_t want = on ? (v | WLED_MOD_EN) : (v & ~WLED_MOD_EN);
+	if (want != v && sweet_spmi_write(WLED_SID, WLED_MOD_ENABLE, want) == 0 && on) {
+		delay(10000);	/* soft start */
+	}
+}
+
+/* 0..4095; the hardware's lowest usable non-zero level is 4. */
+void
+sweet_wled_brightness(unsigned level)
+{
+	if (!sweet_wled_present()) {
+		return;
+	}
+	if (level > WLED_MAX) {
+		level = WLED_MAX;
+	} else if (level && level < 4) {
+		level = 4;
+	}
+	if (sweet_spmi_write(WLED_SID, WLED_MOD_A_BRT_LSB, level & 0xff) ||
+	    sweet_spmi_write(WLED_SID, WLED_MOD_A_BRT_MSB, (level >> 8) & 0x0f) ||
+	    sweet_spmi_write(WLED_SID, WLED_MOD_SYNC, 0) ||
+	    sweet_spmi_write(WLED_SID, WLED_MOD_SYNC, WLED_MOD_SYNC_A)) {
+		printf("SWEET WLED: brightness %u not applied\n", level);
+	}
+}
+
+unsigned
+sweet_wled_get_brightness(void)
+{
+	uint8_t lo, hi;
+
+	if (sweet_spmi_read(WLED_SID, WLED_MOD_A_BRT_LSB, &lo) ||
+	    sweet_spmi_read(WLED_SID, WLED_MOD_A_BRT_MSB, &hi)) {
+		return 0;
+	}
+	return (unsigned)lo | (unsigned)(hi & 0x0f) << 8;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
