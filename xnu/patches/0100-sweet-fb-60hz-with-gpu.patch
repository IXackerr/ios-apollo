+	hz = metal == 1 ? 60 : 10;
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
+	/* the Adreno snoops the CPU caches unless sweetgpu_coherent=0 (SweetAdreno) */
+	uint32_t coherent = 1;
+	PE_parse_boot_argn("sweetgpu_coherent", &coherent, sizeof(coherent));
+	fGpuSnoops = coherent == 1;
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
 	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
 
