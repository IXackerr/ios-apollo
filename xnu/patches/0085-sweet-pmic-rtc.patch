+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint8_t ctrl = 0, b[4], first;
+	if (sweet_spmi_read(0, RTC_CTRL, &ctrl) || !(ctrl & RTC_CTRL_EN)) {
+		return 0;
+	}
+	/* The counter may carry between byte reads: retry while byte 0 moves. */
+	for (int tries = 0; tries < 3; tries++) {
+		for (unsigned i = 0; i < 4; i++) {
+			if (sweet_spmi_read(0, RTC_READ + i, &b[i])) {
+				return 0;
+			}
+		}
+		if (sweet_spmi_read(0, RTC_READ, &first)) {
+			return 0;
+		}
+		if (first == b[0]) {
+			return (long)((uint32_t)b[0] | (uint32_t)b[1] << 8 |
+			       (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24);
+		}
+	}
+	return 0;
+}
