+/* Add delta to a count, never below 0. */
+static inline void
+sweet_surface_count(volatile UInt32 *count, int32_t delta)
+{
+	UInt32 old, now;
+	do {
+		old = *count;
+		now = (int32_t)old + delta < 0 ? 0 : (UInt32)((int32_t)old + delta);
+	} while (!OSCompareAndSwap(old, now, count));
+}
+
+/*
+ * The use counts clients read (SWEET_SURFACE_STATE_USE): category 0 counts
+ * the GPU's work on the surface too, as Apple's GPU driver holds a surface
+ * in use until the work that reads or writes it completed. Rewritten until
+ * it holds the latest counts, whatever ran meanwhile.
+ */
+static inline void
+sweet_surface_publish_use(SweetSurface *s)
+{
+	if (s->state == NULL) {
+		return;
+	}
+	volatile uint32_t *use = (volatile uint32_t *)((uint8_t *)s->state->getBytesNoCopy() +
+	    SWEET_SURFACE_STATE_USE);
+	uint32_t u0, u1;
+	do {
+		u0 = s->uses[0] + s->gpuUses + s->gpuWrites;
+		u1 = s->uses[1];
+		use[0] = u0;
+		use[1] = u1;
+	} while (u0 != s->uses[0] + s->gpuUses + s->gpuWrites || u1 != s->uses[1]);
+}
+
