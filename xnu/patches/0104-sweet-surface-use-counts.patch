 {
-	return kIOReturnSuccess;
+	uintptr_t c = (uintptr_t)category;
+	if (c >= 2) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, NULL);
+	if (ref != NULL && ((ref->used >> c) & 1) != in) {
+		ref->used ^= (uint8_t)(1u << c);
+		sweet_surface_count(&ref->surface->uses[c], in ? 1 : -1);
+		sweet_surface_publish_use(ref->surface);
+	}
+	IOLockUnlock(fLock);
+	return ref != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+}
