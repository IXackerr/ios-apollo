 /*
+ * Every 10 s for the first five minutes: what the device did so far. The
+ * "busy" times are doorbell-to-completion, the part a faster host driver
+ * (queueing, interrupts) cannot remove.
+ */
+static void
+ufs_profile(bool write, uint32_t len, uint64_t elapsed)
+{
+	uint64_t now = mach_absolute_time(), ns, busy_r, busy_w, step;
+
+	su.ncmd[write]++;
+	su.nblk[write] += len / UFS_BLOCK;
+	su.busy[write] += elapsed;
+	if (su.reports >= 30 || now < su.next_report) {
+		return;
+	}
+	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &step);
+	su.next_report = now + step;
+	su.reports++;
+	absolutetime_to_nanoseconds(now, &ns);
+	absolutetime_to_nanoseconds(su.busy[0], &busy_r);
+	absolutetime_to_nanoseconds(su.busy[1], &busy_w);
+	printf("SWEET UFS: %llus read %llu cmds %llu MiB %llu ms, write %llu cmds %llu MiB %llu ms\n",
+	    ns / NSEC_PER_SEC, su.ncmd[0], su.nblk[0] * UFS_BLOCK >> 20, busy_r / NSEC_PER_MSEC,
+	    su.ncmd[1], su.nblk[1] * UFS_BLOCK >> 20, busy_w / NSEC_PER_MSEC);
+}
+
+/*
  * One SCSI command in slot 0, data (if any) to/from the bounce buffer
  * (to the device when write is set). Returns 0 or an errno.
