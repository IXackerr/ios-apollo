+/*
+ * Count GPU work that writes the surface, submitted (+1) or complete (-1),
+ * as the GPU driver learns of it: the framebuffer does not show a surface
+ * the GPU is still rendering. Never below 0.
+ */
+static inline void
+sweet_surface_gpu_writes(SweetSurface *s, int32_t delta)
+{
+	UInt32 old, now;
+	do {
+		old = s->gpuWrites;
+		now = (int32_t)old + delta < 0 ? 0 : (UInt32)((int32_t)old + delta);
+	} while (!OSCompareAndSwap(old, now, &s->gpuWrites));
+}
