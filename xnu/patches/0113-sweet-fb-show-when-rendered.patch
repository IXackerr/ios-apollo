+
+/*
+ * Flipping (flipSetup), a frame needs no particular moment to be copied: it
+ * is shown at the frame start after its flip. So a frame waiting for its
+ * rendering is shown as soon as the GPU is done (surfaceReady), and a frame
+ * already rendered as soon as it is swapped, instead of at the next tick.
+ */
+void
+AppleCLCD::surfaceReady(void)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (fb != NULL && fb->fReady != NULL) {
+		fb->fReady->setTimeoutUS(1);
+	}
+}
+
+void
+AppleCLCD::readyFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	IOLockLock(fb->fLock);
+	bool show = fb->fDirty && !fb->fPowerOff;
+	IOLockUnlock(fb->fLock);
+	if (show) {
+		fb->showPending();
+	}
+}
