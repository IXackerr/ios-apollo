+/*
+ * Flip between two frames instead of copying into the one the panel scans:
+ * a copy made while the panel fetches the same lines showed parts of two
+ * frames. The boot framebuffer region (cont-splash, 23 MiB on apollo) holds
+ * two; the pipe that scans it (found by its source address) takes the other
+ * at the next frame start after a flush. sweetfb_flip=0 keeps copying in
+ * place.
+ */
+void
+AppleCLCD::flipSetup(IOService *provider)
+{
+	uint32_t flip = 1;
+	PE_parse_boot_argn("sweetfb_flip", &flip, sizeof(flip));
+	OSData *mdp = OSDynamicCast(OSData, provider->getProperty("mdp-reg"));
+	OSData *region = OSDynamicCast(OSData, provider->getProperty("fb-region"));
+	if (!flip || mdp == NULL || mdp->getLength() < 16 || region == NULL ||
+	    region->getLength() < 16) {
+		return;
+	}
+	const uint64_t *r = (const uint64_t *)mdp->getBytesNoCopy();
+	const uint64_t *fbr = (const uint64_t *)region->getBytesNoCopy();
+	uint64_t frame = round_page((uint64_t)fRowBytes * fHeight);
+	if (fbr[0] != fPhys || fbr[1] < 2 * frame) {
+		IOLog("SWEET FB: flip: framebuffer region %#llx+%#llx holds no two frames\n",
+		    fbr[0], fbr[1]);
+		return;
+	}
+	vm_offset_t base = ml_io_map((vm_offset_t)r[0], (vm_size_t)round_page(r[1]));
+	if (base == 0) {
+		return;
+	}
+	/*
+	 * Every pipe plane address inside the frame: a panel wider than one
+	 * mixer takes a pipe per half (or a pipe's two rectangles), each
+	 * reading its columns of the same frame.
+	 */
+	volatile uint32_t *sspp = NULL;
+	uint32_t bit = 0;
+	fSrcCount = 0;
+	for (unsigned i = 0; i < sizeof(sspp_offs) / sizeof(sspp_offs[0]); i++) {
+		for (unsigned plane = 0; plane < 4; plane++) {
+			volatile uint32_t *p = (volatile uint32_t *)(base + sspp_offs[i] + SSPP_SRC0_ADDR +
+			    4 * plane);
+			uint32_t a = *p;
+			if (a >= (uint32_t)fPhys && a < (uint32_t)(fPhys + frame) && fSrcCount < 8) {
+				fSrc[fSrcCount] = p;
+				fSrcDelta[fSrcCount++] = a - (uint32_t)fPhys;
+				sspp = p;
+				bit |= 1u << sspp_flush[i];
+				IOLog("SWEET FB: flip: pipe at %#x plane %u reads the frame at +%#x\n",
+				    sspp_offs[i], plane, a - (uint32_t)fPhys);
+			}
+		}
+	}
+	volatile uint32_t *ctl = NULL;
+	for (unsigned i = 0; i < 6; i++) {
+		volatile uint32_t *c = (volatile uint32_t *)(base + 0x2000 + 0x200 * i);
+		uint32_t active = c[CTL_INTF_ACTIVE / 4];
+		if (active != 0 && ctl == NULL) {
+			ctl = c + CTL_FLUSH / 4;
+			IOLog("SWEET FB: flip: control path %u (interfaces %#x)\n", i, active);
+		}
+	}
+	if (sspp == NULL || ctl == NULL) {
+		IOLog("SWEET FB: flip: no pipe or control path found, copying in place\n");
+		return;
+	}
+	/* the second frame: copy the first into it, then check a flush latches */
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress)(fPhys + frame),
+	    (IOByteCount)frame, kIODirectionInOut);
+	IOMemoryMap *map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);
+	if (map == NULL) {
+		return;
+	}
+	fBufPhys[0] = fPhys;
+	fBufPhys[1] = fPhys + frame;
+	fBuf[0] = fPixels;
+	fBuf[1] = (uintptr_t)map->getVirtualAddress();
+	for (uint32_t y = 0; y < fHeight; y++) {
+		memcpy((void *)(fBuf[1] + (uint64_t)y * fRowBytes), (const void *)(fBuf[0] + (uint64_t)y * fRowBytes),
+		    (size_t)fWidth * 4);
+	}
+	fSsppAddr = sspp;
+	fCtlFlush = ctl;
+	fFlushBit = bit;
+	fFront = 0;
+	flipTo(1);
+	for (int i = 0; i < 50 && (*fCtlFlush & fFlushBit); i++) {
+		IOSleep(1);
+	}
+	if (*fCtlFlush & fFlushBit) {
+		IOLog("SWEET FB: flip: the flush did not latch (%#x), copying in place\n", *fCtlFlush);
+		fSsppAddr = NULL;
+		return;
+	}
+	IOLog("SWEET FB: flipping between %#llx and %#llx (pipe now at %#x)\n", fBufPhys[0], fBufPhys[1],
+	    *fSsppAddr);
+}
+
+/* Scan buffer next from the next frame start on. */
+void
+AppleCLCD::flipTo(uint32_t buffer)
+{
+	for (uint32_t i = 0; i < fSrcCount; i++) {
+		*fSrc[i] = (uint32_t)fBufPhys[buffer] + fSrcDelta[i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*fCtlFlush = fFlushBit;
+	fFront = buffer;
+	fPixels = fBuf[buffer];
+}
