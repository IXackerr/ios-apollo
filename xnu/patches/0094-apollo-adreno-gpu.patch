+static uint32_t
+id_size_to_bits(uint32_t f)
+{
+	static const uint32_t bits[] = { 32, 36, 40, 42, 44 };
+	return f < 5 ? bits[f] : 48;
+}
+
+static uint32_t
+oas_to_ips(uint32_t bits)
+{
+	switch (bits) {
+	case 32: return 0;
+	case 36: return 1;
+	case 40: return 2;
+	case 42: return 3;
+	case 44: return 4;
+	default: return 5;
+	}
+}
