+#define ACTLR_PREFETCH          0x00000303u     /* CMTLB | CPRE | deep prefetch (upstream) */
+#define MAIR0_VALUE             0xf404ff44u     /* 0:NC 1:WB-RWA 2:Device-nGnRE 3:iNC/oWB */
