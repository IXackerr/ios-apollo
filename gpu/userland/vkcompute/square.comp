#version 450
// vkcompute: every invocation squares one element of the buffer and mixes
// in its index, so a missing, repeated or misplaced invocation shows up.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Data {
	uint v[];
} data;
layout(push_constant) uniform Push {
	uint count;
	uint rounds;
} pc;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= pc.count) {
		return;
	}
	uint x = data.v[i];
	for (uint r = 0u; r < pc.rounds; r++) {
		x = x * x + (i ^ 0x9e3779b9u);
	}
	data.v[i] = x;
}
