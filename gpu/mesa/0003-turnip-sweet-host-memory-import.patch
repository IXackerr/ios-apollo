+   } else if (fd_info && fd_info->handleType) {
       assert(fd_info->handleType ==
                 VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT ||
              fd_info->handleType ==
@@ -3874,6 +3885,30 @@ tu_allocate_lazy_memory(struct tu_device *dev,
 }
 
 
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetMemoryHostPointerPropertiesEXT(
+   VkDevice _device,
+   VkExternalMemoryHandleTypeFlagBits handleType,
+   const void *pHostPointer,
+   VkMemoryHostPointerPropertiesEXT *pMemoryHostPointerProperties)
+{
+   VK_FROM_HANDLE(tu_device, device, _device);
+   const struct tu_physical_device *pdev = device->physical_device;
+
+   if (handleType != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT)
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   uint32_t bits = 0;
+   for (uint32_t i = 0; i < pdev->memory.type_count; i++) {
+      VkMemoryPropertyFlags f = pdev->memory.types[i];
+      if ((f & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) &&
+          (f & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT))
+         bits |= 1u << i;
+   }
+   pMemoryHostPointerProperties->memoryTypeBits = bits;
+   return VK_SUCCESS;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 tu_FreeMemory(VkDevice _device,
               VkDeviceMemory _mem,
diff --git a/src/freedreno/vulkan/tu_knl.cc b/src/freedreno/vulkan/tu_knl.cc
index 696b52b..d115201 100644
--- a/src/freedreno/vulkan/tu_knl.cc
+++ b/src/freedreno/vulkan/tu_knl.cc
@@ -85,6 +85,22 @@ tu_bo_init_new_explicit_iova(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+VkResult
+tu_bo_init_userptr(struct tu_device *dev,
+                   struct tu_bo **bo,
+                   void *ptr,
+                   uint64_t size)
+{
+   if (!dev->instance->knl->bo_init_userptr)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   VkResult result = dev->instance->knl->bo_init_userptr(dev, bo, ptr, size);
+   if (result != VK_SUCCESS)
+      return result;
+   if (!(*bo)->unique_id)
+      (*bo)->unique_id = (*bo)->gem_handle;
+   return VK_SUCCESS;
+}
