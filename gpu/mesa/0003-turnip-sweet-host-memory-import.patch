turnip: VK_EXT_external_memory_host for the sweet backend

Imports the caller's pages through SweetAdreno IMPORT_USER (UAPI 2), so
Metal's newBufferWithBytesNoCopy: and the mapping of an IOSurface can be
used by the GPU without a copy.
---
diff --git a/src/freedreno/vulkan/sweet/sweet_gpu_uapi.h b/src/freedreno/vulkan/sweet/sweet_gpu_uapi.h
index 49d2229..fd23ee3 100644
--- a/src/freedreno/vulkan/sweet/sweet_gpu_uapi.h
+++ b/src/freedreno/vulkan/sweet/sweet_gpu_uapi.h
@@ -26,7 +26,7 @@
 #include <stdint.h>
 
 #define SGPU_SERVICE_CLASS      "SweetAdreno"
-#define SGPU_UAPI_VERSION       1
+#define SGPU_UAPI_VERSION       2
 
 enum sgpu_selector {
 	SGPU_SEL_GET_INFO       = 0,    /* -> sgpu_info */
@@ -41,6 +41,7 @@ enum sgpu_selector {
 	SGPU_SEL_SYNC_CACHE     = 9,    /* sgpu_sync_cache */
 	SGPU_SEL_GPU_TIME       = 10,   /* -> sgpu_gpu_time */
 	SGPU_SEL_GET_STATUS     = 11,   /* -> sgpu_status (bring-up diagnostics) */
+	SGPU_SEL_IMPORT_USER    = 12,   /* sgpu_import_user -> same (v2) */
 	SGPU_SEL_COUNT
 };
 
@@ -112,6 +113,19 @@ struct sgpu_import_surface {
 	uint64_t size;                  /* out */
 };
 
+/*
+ * Map the caller's own pages into the GPU (VK_EXT_external_memory_host,
+ * newBufferWithBytesNoCopy:, the mapping of an IOSurface). The pages are
+ * wired until MEM_FREE.
+ */
+struct sgpu_import_user {
+	uint64_t addr;                  /* in: page-aligned address in the caller */
+	uint64_t size;                  /* in: whole pages */
+	uint32_t flags;                 /* in: SGPU_MEM_GPU_READONLY */
+	uint32_t id;                    /* out: memory handle (free with MEM_FREE) */
+	uint64_t gpuaddr;               /* out */
+};
+
 struct sgpu_sync_cache {
 	uint32_t id;
 	uint32_t op;                    /* SGPU_CACHE_* */
diff --git a/src/freedreno/vulkan/sweet/sweetgpu.c b/src/freedreno/vulkan/sweet/sweetgpu.c
index bb6295d..381e997 100644
--- a/src/freedreno/vulkan/sweet/sweetgpu.c
+++ b/src/freedreno/vulkan/sweet/sweetgpu.c
@@ -206,6 +206,12 @@ sgpu_import_surface(sgpu_dev *dev, struct sgpu_import_surface *req)
 	return call(dev, SGPU_SEL_IMPORT_SURFACE, req, sizeof(*req), req, sizeof(*req));
 }
 
+int
+sgpu_import_user(sgpu_dev *dev, struct sgpu_import_user *req)
+{
+	return call(dev, SGPU_SEL_IMPORT_USER, req, sizeof(*req), req, sizeof(*req));
+}
+
 int
 sgpu_submit(sgpu_dev *dev, uint32_t ctx_id, const struct sgpu_ib *ibs, uint32_t num_ibs,
     uint32_t flags, uint32_t *timestamp)
diff --git a/src/freedreno/vulkan/sweet/sweetgpu.h b/src/freedreno/vulkan/sweet/sweetgpu.h
index 4133c35..c53d860 100644
--- a/src/freedreno/vulkan/sweet/sweetgpu.h
+++ b/src/freedreno/vulkan/sweet/sweetgpu.h
@@ -35,6 +35,8 @@ int  sgpu_mem_alloc(sgpu_dev *dev, struct sgpu_mem_alloc *req);
 int  sgpu_mem_free(sgpu_dev *dev, uint32_t id);
 int  sgpu_mem_sync(sgpu_dev *dev, uint32_t id, uint32_t op, uint64_t offset, uint64_t length);
 int  sgpu_import_surface(sgpu_dev *dev, struct sgpu_import_surface *req);
+/* Fills id and gpuaddr of *req: the caller's pages at addr, mapped for the GPU. */
+int  sgpu_import_user(sgpu_dev *dev, struct sgpu_import_user *req);
 
 int  sgpu_submit(sgpu_dev *dev, uint32_t ctx_id, const struct sgpu_ib *ibs,
     uint32_t num_ibs, uint32_t flags, uint32_t *timestamp);
